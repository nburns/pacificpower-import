# Local development env file. Copy to .env and fill in.
# Use with: `uv run --env-file .env python -m pacificpower_import ...`

# Pacific Power portal credentials.
PP_USERNAME=
PP_PASSWORD=

# Optional: match against a specific meter's dropdown text (substring OK).
# Leave blank if the account has only one meter.
PP_METER_ID=

# Home Assistant target (local dev — not needed inside the add-on).
# For a local HA instance, generate a long-lived access token in the
# HA UI: Profile → Security → Create Token.
HA_URL=ws://homeassistant.local:8123/api/websocket
HA_TOKEN=

# Statistic identity in HA long-term statistics.
STATISTIC_ID=pacificpower:electric_consumption
STATISTIC_NAME=Pacific Power electric consumption

# Where the scraper stores the persistent browser context and downloads.
DATA_DIR=/tmp/pp
